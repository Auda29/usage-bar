{
  "name": "usage-bar",
  "version": "1.1.5",
  "private": true,
  "description": "Compact multi-provider AI usage in the Windows notification area.",
  "author": "NiklasW",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Auda29/usage-bar.git"
  },
  "homepage": "https://github.com/Auda29/usage-bar#readme",
  "bugs": {
    "url": "https://github.com/Auda29/usage-bar/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "src/main.cjs",
  "scripts": {
    "start": "node scripts/launch.cjs",
    "demo": "node scripts/launch.cjs --demo --show",
    "test": "node --test test/*.test.cjs",
    "check:providers": "node scripts/check-providers.cjs",
    "preview": "node scripts/preview.cjs",
    "smoke": "node scripts/smoke.cjs",
    "icons": "node scripts/icons.cjs",
    "build": "node scripts/package.cjs",
    "build:installer": "npm run build && node scripts/installer.cjs"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@electron/packager": "20.3.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  }
}
